# Server Configuration
PORT=5000

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/spendwise?retryWrites=true&w=majority

# JWT Secret for signing tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Email Service (Nodemailer Gmail SMTP or custom SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
